# Raw experiment outputs. These run to several GB; use tools/aggregate_results.py
# to reduce them into the small CSVs under summaries/.
# No trailing slash: these are often symlinks to scratch storage, and a
# directory-only pattern would not match a symlink.
results
results_gpt_eval
results_archived
results20260313

# Datasets and model checkpoints are fetched, not committed.
datasets
*.pt
*.pth
*.safetensors

# Slurm logs
slurm_logs/
*.out
*.err

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.claude/

# Generated LaTeX snippets (regenerated by the notebooks)
*_snippets.tex

# HuggingFace / model caches
.cache
